{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:studiodroid:schema:session-report:1",
  "title": "StudioDroid session-report v1",
  "description": "Bounded diagnostic metadata; null means unobserved. Report validity does not prove execution or authorize last-known-good promotion.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sessionId": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "configurationFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "lastPhase": {
      "enum": [
        "probe",
        "validate",
        "prepare",
        "start",
        "running",
        "stop",
        "cleanup",
        "unknown"
      ]
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "androidApi": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 999
            },
            {
              "type": "null"
            }
          ]
        },
        "androidVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "targetSdk": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 999
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "soc": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "abi": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "pageSize": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "gpuVendor": {
          "enum": [
            "Adreno",
            "Mali",
            "PowerVR",
            "Unknown/Other"
          ]
        },
        "gpuModel": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "vulkanApiVersion": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?![\\s\\S])",
              "maxLength": 32
            },
            {
              "type": "null"
            }
          ]
        },
        "vulkanDriverVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "androidApi",
        "androidVersion",
        "targetSdk",
        "model",
        "soc",
        "abi",
        "pageSize",
        "gpuVendor",
        "gpuModel",
        "vulkanApiVersion",
        "vulkanDriverVersion"
      ]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtimeBackend": {
          "anyOf": [
            {
              "enum": [
                "fex",
                "box64"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "containerBackend": {
          "anyOf": [
            {
              "enum": [
                "namespace",
                "proot"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "graphicsDriver": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "fexVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "wineVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "dxvkVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "studioVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "profile": {
          "enum": [
            "LOW_MEMORY",
            "BALANCED",
            "PERFORMANCE"
          ]
        }
      },
      "required": [
        "runtimeBackend",
        "containerBackend",
        "graphicsDriver",
        "fexVersion",
        "wineVersion",
        "dxvkVersion",
        "studioVersion",
        "profile"
      ]
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,127}(?![\\s\\S])"
          },
          "kind": {
            "enum": [
              "ARM64Rootfs",
              "X86_64Rootfs",
              "FEX",
              "Wine",
              "DXVK",
              "GraphicsDrivers",
              "Studio"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          }
        },
        "required": [
          "id",
          "kind",
          "version",
          "sha256"
        ]
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "physicalBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "availableBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "processPssBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "processRssBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "swapTotalBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "swapFreeBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "pressure": {
          "enum": [
            "normal",
            "low",
            "critical",
            "unknown"
          ]
        }
      },
      "required": [
        "physicalBytes",
        "availableBytes",
        "processPssBytes",
        "processRssBytes",
        "swapTotalBytes",
        "swapFreeBytes",
        "pressure"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "running",
            "exited",
            "signaled",
            "start-failed",
            "cancelled",
            "unknown"
          ]
        },
        "exitCode": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "signal": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "errno": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "exitCode",
        "signal",
        "errno",
        "message"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "exited"
              }
            }
          },
          "then": {
            "properties": {
              "exitCode": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "signal": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "signaled"
              }
            }
          },
          "then": {
            "properties": {
              "signal": {
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              },
              "exitCode": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "none",
            "execution-proof",
            "studio-ready"
          ]
        },
        "status": {
          "enum": [
            "unverified",
            "passed",
            "failed"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "required": [
        "level",
        "status",
        "evidence"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "passed"
              }
            }
          },
          "then": {
            "properties": {
              "level": {
                "enum": [
                  "execution-proof",
                  "studio-ready"
                ]
              },
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "logs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "category": {
            "enum": [
              "ANDROID",
              "CONTAINER",
              "FEX",
              "WINE",
              "DXVK",
              "VULKAN",
              "DRIVER",
              "STUDIO",
              "INPUT",
              "AUDIO",
              "NETWORK",
              "STORAGE"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^\\\\\\x00\\r\\n]+(?![\\s\\S])"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "droppedMessages": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "category",
          "path",
          "bytes",
          "droppedMessages"
        ]
      },
      "minItems": 0,
      "maxItems": 128
    },
    "redacted": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "sessionId",
    "timestamp",
    "configurationFingerprint",
    "lastPhase",
    "device",
    "selection",
    "components",
    "memory",
    "result",
    "health",
    "logs",
    "redacted"
  ]
}
